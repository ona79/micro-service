# =============================================================================
# UASZ - Plateforme de Valorisation du Patrimoine Touristique de la Casamance
# Variables d'Environnement de Production (Modèle de configuration)
# =============================================================================
# INSTRUCTIONS DE SÉCURITÉ OBLIGATOIRES :
# 1. Copier ce modèle vers le fichier .env : cp .env.example .env
# 2. Générer chaque secret avec une commande cryptographiquement sûre :
#      openssl rand -base64 48
# 3. Ne JAMAIS committer le fichier .env final dans Git (.gitignore configuré).
# 4. Les secrets SECURITY_SESSION_SECRET et SECURITY_INTERSERVICE_SECRET doivent
#    mesurer au minimum 32 octets (256 bits d'entropie) et être DISTINCTS.
# 5. Tout démarrage avec un marqueur d'exemple 'CHANGE_ME' sera immédiatement rejeté.
# =============================================================================

# Mot de passe administrateur PostgreSQL (initialisation du conteneur uniquement)
# Générer avec : openssl rand -base64 32
POSTGRES_ROOT_PASSWORD=CHANGE_ME_GENERATE_POSTGRES_ROOT_PASSWORD_VIA_OPENSSL

# Mots de passe individuels des 7 microservices (Principe du moindre privilège)
# Générer chaque mot de passe indépendamment : openssl rand -base64 32
PATRIMOINE_DB_PASSWORD=CHANGE_ME_GENERATE_PATRIMOINE_DB_PASSWORD_VIA_OPENSSL
CIRCUIT_DB_PASSWORD=CHANGE_ME_GENERATE_CIRCUIT_DB_PASSWORD_VIA_OPENSSL
EVENEMENT_DB_PASSWORD=CHANGE_ME_GENERATE_EVENEMENT_DB_PASSWORD_VIA_OPENSSL
RESERVATION_DB_PASSWORD=CHANGE_ME_GENERATE_RESERVATION_DB_PASSWORD_VIA_OPENSSL
UTILISATEUR_DB_PASSWORD=CHANGE_ME_GENERATE_UTILISATEUR_DB_PASSWORD_VIA_OPENSSL
PAIEMENT_DB_PASSWORD=CHANGE_ME_GENERATE_PAIEMENT_DB_PASSWORD_VIA_OPENSSL
NOTIFICATION_DB_PASSWORD=CHANGE_ME_GENERATE_NOTIFICATION_DB_PASSWORD_VIA_OPENSSL

# Clé secrète cryptographique HMAC-SHA256 pour les sessions JWT et l'enveloppe Gateway
# Minimum 32 octets (256 bits d'entropie). Générer avec : openssl rand -base64 48
SECURITY_SESSION_SECRET=CHANGE_ME_GENERATE_SESSION_HMAC_SECRET_VIA_OPENSSL_MIN_32_BYTES

# Clé secrète cryptographique HMAC-SHA256 dédiée aux appels inter-microservices (OpenFeign/RestTemplate/WebClient)
# Doit être DISTINCTE de SECURITY_SESSION_SECRET. Générer avec : openssl rand -base64 48
SECURITY_INTERSERVICE_SECRET=CHANGE_ME_GENERATE_INTERSERVICE_HMAC_SECRET_VIA_OPENSSL_MIN_32_BYTES
