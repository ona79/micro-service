# =============================================================================
# UASZ - Plateforme de Valorisation du Patrimoine Touristique de la Casamance
# Variables d'Environnement de Production (Modèle de configuration)
# =============================================================================
# INSTRUCTIONS DE SÉCURITÉ :
# 1. Copier ce fichier sous le nom .env : cp .env.example .env
# 2. Remplacer impérativement toutes les valeurs ci-dessous par des secrets forts.
# 3. Ne JAMAIS committer le fichier .env final dans Git (.gitignore configuré).
# 4. Le secret SECURITY_SESSION_SECRET doit mesurer au minimum 32 octets (256 bits).
# =============================================================================

# Mot de passe du superutilisateur PostgreSQL (utilisé uniquement à l'initialisation)
POSTGRES_ROOT_PASSWORD=Definir_Un_Mot_De_Passe_Root_Tres_Fort_2026!

# Mots de passe individuels des 7 microservices (Isolation Moindre Privilège)
PATRIMOINE_DB_PASSWORD=Patrimoine_Securise_Db_Pass_2026_Casamance!
CIRCUIT_DB_PASSWORD=Circuit_Securise_Db_Pass_2026_Casamance!
EVENEMENT_DB_PASSWORD=Evenement_Securise_Db_Pass_2026_Casamance!
RESERVATION_DB_PASSWORD=Reservation_Securise_Db_Pass_2026_Casamance!
UTILISATEUR_DB_PASSWORD=Utilisateur_Securise_Db_Pass_2026_Casamance!
PAIEMENT_DB_PASSWORD=Paiement_Securise_Db_Pass_2026_Casamance!
NOTIFICATION_DB_PASSWORD=Notification_Securise_Db_Pass_2026_Casamance!

# Clé secrète HMAC-SHA256 pour les jetons de session (Gateway & ms-utilisateur)
# Exigence de sécurité : Minimum 32 octets (256 bits d'entropie)
SECURITY_SESSION_SECRET=CleSecreteProductionHmacSha256PourCasamanceUasz2026Min32Bytes!
